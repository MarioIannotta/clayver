{
  "name": "@clayver/core",
  "version": "0.1.0",
  "description": "Typed data model and framework-agnostic Firebase data-access layer for Clayver agent dashboards.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clayver/clayver.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/clayver/clayver/tree/main/packages/core#readme",
  "bugs": "https://github.com/clayver/clayver/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "firebase": "^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "firebase": "^12.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
